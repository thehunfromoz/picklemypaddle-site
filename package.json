{
  "name": "picklemypaddle-site",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "description": "Pickle My Paddle website: pickleball paddle re-grit service. Built with Astro 7 and Tailwind v4, based on Small Business Starter v2 (MIT).",
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@10.18.0",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "check": "astro check",
    "test": "pnpm test:unit && pnpm test:e2e",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "test:report": "playwright show-report",
    "check:placeholders": "node scripts/check-placeholders.mjs",
    "brand:og": "node scripts/make-og-image.mjs",
    "check:secrets": "node scripts/check-no-secrets-in-build.mjs dist",
    "lint": "eslint .",
    "check:links": "node scripts/check-links.mjs dist"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource/sora": "^5.2.0",
    "@fontsource/work-sans": "^5.2.0",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.3.2",
    "astro-robots-txt": "^1.0.0",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "@axe-core/playwright": "^4.10.0",
    "@eslint/js": "^9.15.0",
    "@playwright/test": "^1.58.2",
    "eslint": "^9.15.0",
    "eslint-plugin-astro": "^1.3.1",
    "globals": "^15.12.0",
    "sharp": "^0.35.4",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.15.0",
    "vitest": "^3.2.0"
  }
}
