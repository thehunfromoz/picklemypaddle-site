{
  "name": "picklemypaddle-site",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "description": "PickleMyPaddle website: pickleball paddle re-grit service. Built with Astro 7 and Tailwind v4, based on Small Business Starter v2 (MIT).",
  "license": "MIT",
  "engines": {
    "node": ">=22.19.0"
  },
  "packageManager": "pnpm@10.18.0",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "check": "astro check",
    "test": "pnpm test:unit && pnpm test:e2e",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "test:report": "playwright show-report",
    "check:placeholders": "node scripts/check-placeholders.mjs",
    "brand:og": "node scripts/make-og-image.mjs",
    "check:secrets": "node scripts/check-no-secrets-in-build.mjs dist",
    "lint": "eslint .",
    "check:links": "node scripts/check-links.mjs dist",
    "check:lighthouse": "node scripts/lighthouse-budget.mjs",
    "build:editor": "astro build --config astro.editor.config.mjs",
    "start:editor": "node dist-editor/server/entry.mjs"
  },
  "dependencies": {
    "@fontsource/sora": "^5.2.0",
    "@fontsource/work-sans": "^5.2.0",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.3.2",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "@astrojs/node": "^11.1.9",
    "@astrojs/react": "^7.1.0",
    "@axe-core/playwright": "^4.10.0",
    "@eslint/js": "^9.15.0",
    "@keystatic/astro": "^6.0.0",
    "@keystatic/core": "^0.6.9",
    "@playwright/test": "^1.58.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "chrome-launcher": "^1.2.2",
    "eslint": "^10.13.0",
    "eslint-plugin-astro": "^3.2.1",
    "globals": "^17.13.0",
    "lighthouse": "^13.5.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "schema-dts": "^2.1.0",
    "sharp": "^0.35.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.15.0",
    "vitest": "^5.0.5",
    "yaml": "^2.9.1"
  }
}
