# Copy to .env for local development. Only PUBLIC_ values reach the browser;
# never put private keys in this repo or in PUBLIC_ variables.

# Canonical site URL for sitemap, canonical and Open Graph tags.
SITE_URL=http://localhost:4321

# Endpoint of picklemypaddle-integrations that receives order submissions.
# Leave empty to show "Online ordering opens soon".
PUBLIC_ORDER_API_URL=
