# syntax=docker/dockerfile:1.7
# Keystatic blog editor (SCRUM-34): STAGING ONLY. Published as
# ghcr.io/thehunfromoz/picklemypaddle-site-editor:<sha> and run by the staging stack
# (picklemypaddle-infra/staging) behind the gateway, reachable over Tailscale only.
# Production never runs it, and the public site image (Dockerfile) never contains it.
#
# The image holds no secrets: the GitHub App's client ID and secret and KEYSTATIC_SECRET are
# read at runtime from the root-only /etc/picklemypaddle/editor.env on home-server.

# ── Build ────────────────────────────────────────────────────────────────────
FROM node:26-alpine AS build
WORKDIR /app
RUN npm install --global pnpm@10.18.0
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml ./
RUN pnpm install --frozen-lockfile
COPY . .
# Not secret: the GitHub App's URL name, used for Keystatic's "install the app" link.
ARG PUBLIC_KEYSTATIC_GITHUB_APP_SLUG=picklemypaddle-blog-editor
# The Tailscale address the editor is opened at (must match the GitHub App's callback URL).
ARG EDITOR_HOST=home-server.tail8bc7ae.ts.net
ARG EDITOR_PORT=8444
ENV PUBLIC_KEYSTATIC_GITHUB_APP_SLUG=${PUBLIC_KEYSTATIC_GITHUB_APP_SLUG} EDITOR_HOST=${EDITOR_HOST} EDITOR_PORT=${EDITOR_PORT}
RUN pnpm build:editor

# ── Run ──────────────────────────────────────────────────────────────────────
FROM node:26-alpine
LABEL org.opencontainers.image.source="https://github.com/thehunfromoz/picklemypaddle-site" \
      org.opencontainers.image.description="PickleMyPaddle blog editor (Keystatic), staging only" \
      org.opencontainers.image.licenses="MIT"
# The server bundle has every dependency built in (astro.editor.config.mjs), so npm and corepack
# aren't needed at runtime; removing them keeps their dependencies out of the vulnerability scan.
RUN rm -rf /usr/local/lib/node_modules/npm /usr/local/lib/node_modules/corepack \
      /usr/local/bin/npm /usr/local/bin/npx /usr/local/bin/corepack
WORKDIR /app
COPY --from=build --chown=root:root /app/dist-editor ./dist-editor
USER node
ENV NODE_ENV=production HOST=0.0.0.0 PORT=4321
EXPOSE 4321
HEALTHCHECK --interval=15s --timeout=3s --retries=3 CMD wget -qO- http://127.0.0.1:4321/keystatic >/dev/null || exit 1
CMD ["node", "dist-editor/server/entry.mjs"]
