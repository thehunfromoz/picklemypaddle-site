---
// Posts in each enabled language other than the default: /<lang>/blog/<slug> (SCRUM-34).
// Only English is enabled today, so this builds no pages yet.
import BlogPost from '../../../components/blog/BlogPost.astro';
import { defaultLang } from '../../../config/i18n';
import { publishedPosts, type PostInfo } from '../../../lib/blog';

export async function getStaticPaths() {
  const posts = (await publishedPosts()).filter((p) => p.lang !== defaultLang);
  return posts.map((current) => ({ params: { lang: current.lang, slug: current.slug }, props: { current } }));
}

const { current } = Astro.props as { current: PostInfo };
---

<BlogPost current={current} />
