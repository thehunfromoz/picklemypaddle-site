---
import BaseLayout from '../layouts/BaseLayout.astro';
import Banner from '../components/Banner.astro';
import Ph from '../components/Ph.astro';
import { faq } from '../data/faq';
import { siteData } from '../data/siteData';
---

<BaseLayout
  title="FAQ"
  description="Answers to common questions about pickleball paddle re-gritting: cost, turnaround, payment and tracking."
  schema={{
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faq
      .filter((f) => !f.a.includes('[To confirm'))
      .map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
  }}
>
  <Banner title="Frequently asked questions" />

  <section class="py-section">
    <div class="mx-auto max-w-3xl space-y-3 px-4 sm:px-6">
      {faq.map(({ q, a }) => (
        <details class="group rounded-lg border border-border bg-surface p-5 open:bg-tint-green/40">
          <summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-heading text-lg font-bold">
            {q}
            <span class="text-primary transition-transform group-open:rotate-45" aria-hidden="true">+</span>
          </summary>
          <p class="mt-3 leading-relaxed text-text-muted"><Ph text={a} /></p>
        </details>
      ))}
      <p class="pt-6 text-text-muted">
        Still have a question? Email
        <a href={`mailto:${siteData.contact.email}`} class="font-semibold text-primary underline">{siteData.contact.email}</a>.
      </p>
    </div>
  </section>
</BaseLayout>
