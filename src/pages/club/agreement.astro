---
/**
 * The club agreement, printable (SCRUM-94): /club/agreement#<token>, linked from the agreement email.
 * The token is minted for that email (only its hash is kept by the service), stays in the fragment and
 * is sent in a POST body. The text is the version that was sent; every word comes from the service
 * and is set as text, never as HTML. Static, noindex, no-referrer, not cached (deploy/Caddyfile),
 * not in the sitemap.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';

const clubEmail = 'attila@picklemypaddle.com';
---

<BaseLayout title="Club agreement" description="Your club’s PickleMyPaddle agreement." noindex>
  <meta slot="head" name="referrer" content="no-referrer" />
  <section class="py-section print:py-0">
    <div class="mx-auto max-w-3xl px-4 sm:px-6 print:max-w-none print:px-0">
      <p id="agreement-loading" class="text-text-muted" data-testid="agreement-loading" role="status">Loading your agreement…</p>

      <div id="agreement-invalid" class="rounded-lg bg-surface p-6" data-testid="agreement-invalid" hidden>
        <h1 class="font-heading text-h3 font-bold">This agreement link isn’t valid or has expired</h1>
        <p class="mt-3">
          Use the link in the latest agreement email, or reply to that email and we’ll send a fresh one. You can also email
          <a class="font-semibold text-primary underline" href={`mailto:${clubEmail}`}>{clubEmail}</a>.
        </p>
      </div>

      <div id="agreement-view" data-testid="agreement-view" hidden>
        <p class="no-print mb-6 flex flex-wrap items-center gap-3">
          <button type="button" id="agreement-print" class="btn-secondary" data-testid="agreement-print">Print or save as PDF</button>
        </p>
        <article class="rounded-lg border border-border bg-white p-6 text-text sm:p-8 print:border-0 print:p-0" data-testid="agreement">
          <p id="agreement-test" class="mb-4 rounded-md bg-tint-blue p-3 text-sm" data-testid="agreement-test" hidden>
            TEST: this is a trial from the staging site. It is not a real agreement.
          </p>
          <h1 id="agreement-title" class="font-heading text-h2 font-bold" data-testid="agreement-title"></h1>
          <p id="agreement-status" class="mt-2 text-sm text-text-muted" data-testid="agreement-status"></p>
          <div id="agreement-body" class="mt-6 space-y-3 leading-relaxed" data-testid="agreement-body"></div>
          <h2 class="mt-8 font-heading text-h3 font-bold">Schedule: the club’s details</h2>
          <dl id="agreement-schedule" class="mt-3 grid grid-cols-1 gap-x-6 gap-y-2 text-sm sm:grid-cols-[max-content_1fr]" data-testid="agreement-schedule"></dl>
        </article>
        <p class="no-print mt-4 text-sm text-text-muted">This link is private to your club. Keep a copy of the agreement for your records.</p>
      </div>
    </div>
  </section>
</BaseLayout>

<style is:global>
  @media print {
    body > :not(main),
    .no-print {
      display: none !important;
    }
    body {
      padding: 0 !important;
      background: #fff !important;
    }
  }
</style>

<script>
  import { AGREEMENT_API_URL, agreementStatusLine, agreementTokenFrom, type AgreementView } from '../../lib/agreement';

  const $ = (id: string) => document.getElementById(id)!;
  const show = (id: string, on = true) => {
    $(id).hidden = !on;
  };
  const el = (tag: string, text: string, className = '') => {
    const e = document.createElement(tag);
    e.textContent = text;
    if (className) e.className = className;
    return e;
  };

  function invalid() {
    show('agreement-loading', false);
    show('agreement-invalid');
  }

  function render(v: AgreementView) {
    $('agreement-title').textContent = `${v.title}, version ${v.label}`;
    $('agreement-status').textContent = agreementStatusLine(v);
    show('agreement-test', v.test);
    const body = $('agreement-body');
    body.replaceChildren();
    for (const s of v.sections) {
      body.append(el('h2', s.heading, 'mt-6 font-heading text-h3 font-bold'));
      for (const b of s.blocks) {
        if ('p' in b) body.append(el('p', b.p));
        else {
          const ul = document.createElement('ul');
          ul.className = 'list-disc space-y-1 pl-6';
          for (const item of b.list) ul.append(el('li', item));
          body.append(ul);
        }
      }
    }
    const dl = $('agreement-schedule');
    dl.replaceChildren();
    for (const [item, details] of v.schedule) {
      dl.append(el('dt', item, 'font-semibold'), el('dd', details));
    }
    show('agreement-loading', false);
    show('agreement-view');
  }

  async function load() {
    const token = agreementTokenFrom(location.hash);
    if (!token) return invalid();
    try {
      const res = await fetch(AGREEMENT_API_URL, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
        body: JSON.stringify({ token }),
        cache: 'no-store',
        referrerPolicy: 'no-referrer',
      });
      if (!res.ok) return invalid();
      render((await res.json()) as AgreementView);
    } catch {
      invalid();
    }
  }

  $('agreement-print').addEventListener('click', () => window.print());
  void load();
</script>
