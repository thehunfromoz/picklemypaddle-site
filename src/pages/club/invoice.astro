---
/**
 * A club batch's invoice, printable (SCRUM-85): /club/invoice?n=PMP-INV-0001#<token>, linked from
 * the invoice email. The token is minted for that email (only its hash is kept by the service),
 * stays in the fragment and is sent in a POST body. Every word and amount comes from the invoice's
 * frozen snapshot. Static, noindex, no-referrer, not cached (deploy/Caddyfile), not in the sitemap.
 *
 * Part 2: the payments recorded so far and what's still owing, and "Pay by card" (Stripe Checkout)
 * when the service offers it. Before leaving for Stripe the number and token are kept in this
 * tab's sessionStorage, so /club/paid and a cancelled payment (?payment=cancelled, no fragment:
 * the token never goes to Stripe) find the invoice again.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import DocumentArticle from '../../components/DocumentArticle.astro';

const clubEmail = 'attila@picklemypaddle.com';
---

<BaseLayout title="Club invoice" description="Your club’s PickleMyPaddle invoice." noindex>
  <meta slot="head" name="referrer" content="no-referrer" />
  <section class="py-section print:py-0">
    <div class="mx-auto max-w-3xl px-4 sm:px-6 print:max-w-none print:px-0">
      <p id="doc-loading" class="text-text-muted" data-testid="doc-loading" role="status">Loading your invoice…</p>

      <div id="doc-invalid" class="rounded-lg bg-surface p-6" data-testid="doc-invalid" hidden>
        <h1 class="font-heading text-h3 font-bold">This invoice link isn’t valid or has expired</h1>
        <p class="mt-3">
          Use the link in the latest invoice email, or reply to that email and we’ll send a fresh one. You can also email
          <a class="font-semibold text-primary underline" href={`mailto:${clubEmail}`}>{clubEmail}</a>.
        </p>
      </div>

      <div id="doc-view" data-testid="doc-view" hidden>
        <p id="pay-cancelled" class="no-print mb-4 rounded-md bg-tint-blue p-3 text-sm" data-testid="pay-cancelled" role="status" hidden>
          Card payment cancelled: nothing was charged.
        </p>
        <p class="no-print mb-6 flex flex-wrap items-center gap-3">
          <button type="button" id="doc-print" class="btn-secondary" data-testid="doc-print">Print or save as PDF</button>
        </p>
        <DocumentArticle />
        <div id="club-payments" class="mt-4 rounded-lg bg-surface p-4" data-testid="club-payments" hidden>
          <h2 class="font-heading text-lg font-bold">Payments received</h2>
          <ul id="club-payment-list" class="mt-2 space-y-1" data-testid="club-payment-list"></ul>
          <p id="club-owing" class="mt-2 font-semibold" data-testid="club-owing" hidden></p>
        </div>
        <p id="club-pay-notice" class="no-print mt-4 rounded-md bg-tint-blue p-3 text-sm" data-testid="club-pay-notice" role="status" hidden></p>
        <div id="club-pay" class="no-print mt-4" data-testid="club-pay" hidden>
          <button type="button" id="club-pay-now" class="btn-primary" data-testid="club-pay-now">Pay by card</button>
          <p class="mt-2 text-sm text-text-muted">You’ll pay by card on Stripe’s secure page. Card details go to Stripe, our payment provider, and never to us. PayID or cash (as on the invoice) is still fine.</p>
          <p id="club-pay-error" class="mt-2 text-sm font-medium text-[#A12B2B]" role="alert" data-testid="club-pay-error" hidden></p>
        </div>
        <p class="no-print mt-4 text-sm text-text-muted">This link is private to your club. Keep a copy of the invoice for your records.</p>
      </div>
    </div>
  </section>
</BaseLayout>

<style is:global>
  @media print {
    body > :not(main),
    .no-print {
      display: none !important;
    }
    body {
      padding: 0 !important;
      background: #fff !important;
    }
  }
</style>

<script>
  import { clubPaymentLines, documentMoney, documentParams, type ClubInvoiceView } from '../../lib/document';
  import { renderDocument, show } from '../../lib/document-view';
  import { CLUB_PAY_KEY, clubPayMemory, isCheckoutUrl } from '../../lib/payment';

  const CLUB_API_URL = '/api/clubs';
  let current: { number: string; token: string } | null = null;

  const remembered = () => {
    try {
      return clubPayMemory(sessionStorage.getItem(CLUB_PAY_KEY));
    } catch {
      return null;
    }
  };

  function renderPayments(v: ClubInvoiceView) {
    const { payments, owing } = clubPaymentLines(v);
    if (payments.length) {
      document.getElementById('club-payment-list')!.replaceChildren(
        ...payments.map((text) => {
          const li = document.createElement('li');
          li.textContent = text;
          return li;
        }),
      );
    }
    // Shown and hidden from what the invoice says now: a reload after "paid meanwhile" must not
    // leave an old "Still owing" line on a paid invoice.
    show('club-payments', payments.length > 0);
    document.getElementById('club-owing')!.textContent = owing ?? '';
    show('club-owing', Boolean(owing));
    const pay = document.getElementById('club-pay-now')!;
    pay.textContent = v.balanceCents ? `Pay ${documentMoney(v.balanceCents)} by card` : 'Pay by card';
    show('club-pay', !v.paid && v.canPayByCard === true);
  }

  function invalid() {
    show('doc-loading', false);
    show('doc-invalid');
  }

  async function load() {
    show('pay-cancelled', false);
    show('club-pay-notice', false);
    let params = documentParams(location.search, location.hash);
    // Back from Stripe with "Cancel": the link was remembered in this tab, not sent to Stripe.
    if (!params && new URLSearchParams(location.search).get('payment') === 'cancelled') {
      const kept = remembered();
      const number = new URLSearchParams(location.search).get('n');
      if (kept && kept.number === number) {
        params = kept;
        history.replaceState(null, '', `/club/invoice?n=${encodeURIComponent(kept.number)}#${kept.token}`);
        show('pay-cancelled');
      }
    }
    if (!params) return invalid();
    current = params;
    try {
      const res = await fetch(`${CLUB_API_URL}/invoice`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
        body: JSON.stringify({ token: params.token, number: params.number }),
        cache: 'no-store',
        referrerPolicy: 'no-referrer',
      });
      if (!res.ok) return invalid();
      const view = (await res.json()) as ClubInvoiceView;
      renderDocument(view);
      renderPayments(view);
    } catch {
      invalid();
    }
  }

  document.getElementById('doc-print')?.addEventListener('click', () => window.print());

  const payBtn = document.getElementById('club-pay-now') as HTMLButtonElement | null;
  payBtn?.addEventListener('click', async () => {
    if (!current) return;
    const err = document.getElementById('club-pay-error')!;
    const label = payBtn.textContent;
    err.hidden = true;
    payBtn.disabled = true;
    payBtn.textContent = 'Opening Stripe…';
    const fail = (msg: string) => {
      err.textContent = msg;
      err.hidden = false;
      payBtn.disabled = false;
      payBtn.textContent = label;
    };
    try {
      const res = await fetch(`${CLUB_API_URL}/pay`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
        body: JSON.stringify(current),
        cache: 'no-store',
        referrerPolicy: 'no-referrer',
      });
      const data = (await res.json().catch(() => ({}))) as { url?: string; message?: string };
      if (res.ok && isCheckoutUrl(data.url)) {
        try {
          sessionStorage.setItem(CLUB_PAY_KEY, JSON.stringify(current));
        } catch {
          // private browsing: the emailed link still works afterwards
        }
        location.assign(data.url);
        return;
      }
      const message = data.message ?? 'We couldn’t start the payment just now. Please try again in a minute.';
      if (res.status === 409) {
        // Paid meanwhile: show where it stands now, with the reason beside it (the pay box may hide).
        await load();
        const notice = document.getElementById('club-pay-notice')!;
        notice.textContent = message;
        show('club-pay-notice');
        payBtn.disabled = false;
        payBtn.textContent = label;
        return;
      }
      fail(message);
    } catch {
      fail('We couldn’t start the payment just now. Please try again in a minute.');
    }
  });
  void load();
</script>
