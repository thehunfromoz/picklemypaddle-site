---
// Default-language posts keep their original URL, /blog/<slug> (SCRUM-34).
import BlogPost from '../../components/blog/BlogPost.astro';
import { defaultLang } from '../../config/i18n';
import { publishedPosts, type PostInfo } from '../../lib/blog';

export async function getStaticPaths() {
  const posts = await publishedPosts(defaultLang);
  return posts.map((current) => ({ params: { slug: current.slug }, props: { current } }));
}

const { current } = Astro.props as { current: PostInfo };
---

<BlogPost current={current} />
