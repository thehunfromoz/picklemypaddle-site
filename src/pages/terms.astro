---
import BaseLayout from '../layouts/BaseLayout.astro';
import Banner from '../components/Banner.astro';
import LegalPage from '../components/LegalPage.astro';
import { termsOfService } from '../data/terms';
---

<BaseLayout title="Terms" description="Terms for the Pickle My Paddle website and paddle re-gritting service.">
  <Banner title="Terms of service" />
  <LegalPage effectiveDate={termsOfService.effectiveDate} sections={termsOfService.sections} />
</BaseLayout>
