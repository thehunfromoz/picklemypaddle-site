---
import BaseLayout from '../layouts/BaseLayout.astro';
import Banner from '../components/Banner.astro';
import LegalPage from '../components/LegalPage.astro';
import { termsOfService } from '../data/terms';
---

<BaseLayout title="Terms" description="The terms for using the PickleMyPaddle website and for our paddle re-gritting service: orders, payment, turnaround, refunds and problems.">
  <Banner title="Terms of service" />
  <LegalPage lastUpdated={termsOfService.lastUpdated} sections={termsOfService.sections} />
</BaseLayout>
