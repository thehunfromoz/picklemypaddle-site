---
import { brand } from '../config/brand';
import { siteData } from '../data/siteData';
import Logo from './Logo.astro';

const year = new Date().getFullYear();
const socials = Object.entries(siteData.socials).filter(([, url]) => url);
---

<footer class="bg-dark text-white/85">
  <div class="mx-auto max-w-site px-4 py-12 sm:px-6 lg:py-16">
    <div class="grid grid-cols-1 gap-10 sm:grid-cols-2 lg:grid-cols-4">
      <div class="sm:col-span-2 lg:col-span-1">
        <a href="/" class="inline-flex items-center gap-2.5 rounded-md">
          <span class="rounded-md bg-background p-1.5"><Logo variant="icon" class="h-9 w-auto" /></span>
          <span class="font-heading text-lg font-bold text-white">{brand.wordmark}</span>
        </a>
        <p class="mt-3 max-w-xs text-sm leading-relaxed">{brand.tagline} Pickleball paddle re-gritting, {siteData.contact.area}.</p>
        {socials.length > 0 && (
          <ul class="mt-4 flex gap-4 text-sm">
            {socials.map(([name, url]) => (
              <li><a href={url} rel="noopener noreferrer" class="capitalize hover:text-white">{name}</a></li>
            ))}
          </ul>
        )}
      </div>

      {siteData.footerNav.map((col) => (
        <div>
          <h2 class="text-sm font-semibold uppercase tracking-wider text-white">{col.title}</h2>
          <ul class="mt-3 space-y-2">
            {col.links.map(({ label, href }) => (
              <li><a href={href} class="text-sm hover:text-white">{label}</a></li>
            ))}
          </ul>
        </div>
      ))}

      <div>
        <h2 class="text-sm font-semibold uppercase tracking-wider text-white">Contact</h2>
        <ul class="mt-3 space-y-2 text-sm">
          <li><a href={`mailto:${siteData.contact.email}`} class="hover:text-white">{siteData.contact.email}</a></li>
          <li>{siteData.contact.area}</li>
        </ul>
      </div>
    </div>

    <div class="mt-10 border-t border-white/15 pt-6 text-center text-sm">
      &copy; {year} {brand.name}. Prices in {siteData.pricing.currency}.
    </div>
  </div>
</footer>
