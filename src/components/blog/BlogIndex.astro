---
// The blog index for one language (SCRUM-34). Used by /blog and /<lang>/blog.
import BaseLayout from '../../layouts/BaseLayout.astro';
import Banner from '../Banner.astro';
import { languages, type Lang } from '../../config/i18n';
import { publishedPosts } from '../../lib/blog';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const posts = await publishedPosts(lang);
const htmlLang = languages[lang].htmlLang;
---

<BaseLayout
  title="Blog"
  lang={htmlLang}
  description="Pickleball paddle care, how re-gritting works and news from PickleMyPaddle, written for club and social players."
>
  <Banner title="Blog" intro="Paddle care, re-gritting and news from the workbench." />

  <section class="py-section">
    <div class="mx-auto max-w-site px-4 sm:px-6">
      {posts.length === 0 ? (
        <p class="text-text-muted">No posts yet. Check back soon.</p>
      ) : (
        <ul class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3" role="list">
          {posts.map(({ post, url }) => (
            <li class="relative flex flex-col rounded-lg border border-border bg-surface p-6 transition-shadow hover:shadow-md">
              <time class="text-sm text-text-muted" datetime={post.data.date.toISOString()}>
                {post.data.date.toLocaleDateString(htmlLang, { year: 'numeric', month: 'long', day: 'numeric' })}
              </time>
              <h2 class="mt-2 font-heading text-h3 font-bold">
                <a href={url} class="after:absolute after:inset-0">{post.data.title}</a>
              </h2>
              <p class="mt-2 flex-1 text-sm leading-relaxed text-text-muted">{post.data.description}</p>
              <span class="mt-4 text-sm font-semibold text-primary" aria-hidden="true">Read more &rarr;</span>
            </li>
          ))}
        </ul>
      )}
    </div>
  </section>
</BaseLayout>
