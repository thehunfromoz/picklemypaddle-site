---
import { brand } from '../config/brand';
import { siteData } from '../data/siteData';
import Logo from './Logo.astro';
import { galleryPairs } from '../config/images';
import { showGallery } from '../lib/visibility';

const { orderCta } = siteData;
// Hide links to landing-page sections that aren't shown yet.
const nav = siteData.nav.filter((l) => l.href !== '/#gallery' || showGallery(galleryPairs));
const strip = (p: string) => (p.length > 1 && p.endsWith('/') ? p.slice(0, -1) : p);
const currentPath = strip(Astro.url.pathname);
const isActive = (href: string) => !href.includes('#') && href !== '/' && currentPath.startsWith(href);
---

<header class="sticky top-0 z-50 w-full border-b border-border bg-background/95 backdrop-blur-sm">
  <div class="mx-auto flex max-w-site items-center justify-between gap-4 px-4 py-3 sm:px-6">
    <a href="/" class="flex items-center gap-2.5 rounded-md" aria-label={`${brand.name} home`}>
      <Logo variant="icon" class="h-10 w-auto" />
      <span class="font-heading text-xl font-bold tracking-tight text-text">{brand.wordmark}</span>
    </a>

    <nav class="hidden items-center gap-1 lg:flex" aria-label="Primary navigation">
      {nav.map(({ label, href }) => (
        <a
          href={href}
          aria-current={isActive(href) ? 'page' : undefined}
          class:list={[
            'rounded-md px-3 py-2 text-sm font-medium transition-colors',
            isActive(href) ? 'bg-tint-blue text-text' : 'text-text-muted hover:text-text',
          ]}
        >
          {label}
        </a>
      ))}
    </nav>

    <div class="hidden lg:block">
      <a href={orderCta.href} class="btn-primary text-sm">{orderCta.label}</a>
    </div>

    <!--
      The mobile menu is a native <details> disclosure, so it opens on the first tap from first paint,
      with no script at all (SCRUM-39: it used to need a deferred module script, which cannot run until
      every earlier request has finished, so one slow request left the hamburger dead for a minute).
      The script below only adds Escape, tap-outside and close-on-link.
    -->
    <details id="mobile-nav" class="mobile-nav lg:hidden">
      <summary
        id="menu-toggle"
        class="inline-flex min-h-11 min-w-11 cursor-pointer items-center justify-center rounded-md text-text hover:bg-tint-blue"
      >
        <span class="sr-only">Menu</span>
        <span class="hamburger-box" aria-hidden="true">
          <span class="hamburger-bar"></span>
          <span class="hamburger-bar"></span>
          <span class="hamburger-bar"></span>
        </span>
      </summary>

      <div id="mobile-menu" class="mobile-drawer border-y border-border bg-background shadow-lg">
        <nav class="flex flex-col gap-1 px-3 pt-3" aria-label="Mobile navigation">
          {nav.map(({ label, href }) => (
            <a
              href={href}
              aria-current={isActive(href) ? 'page' : undefined}
              class="rounded-md px-3 py-3 text-base font-medium text-text hover:bg-tint-blue"
            >
              {label}
            </a>
          ))}
        </nav>
        <div class="px-6 pt-3 pb-6">
          <a href={orderCta.href} class="btn-primary w-full">{orderCta.label}</a>
        </div>
      </div>
    </details>
  </div>
</header>

<style>
  /* Plain <summary>: no disclosure triangle. */
  .mobile-nav > summary { list-style: none; }
  .mobile-nav > summary::-webkit-details-marker { display: none; }

  .hamburger-box { display: flex; flex-direction: column; justify-content: center; gap: 5px; width: 22px; height: 22px; }
  .hamburger-bar { display: block; width: 100%; height: 2px; border-radius: 9999px; background-color: currentColor; transition: transform 0.3s ease, opacity 0.3s ease; }
  .mobile-nav[open] .hamburger-bar:nth-child(1) { transform: translateY(7px) rotate(45deg); }
  .mobile-nav[open] .hamburger-bar:nth-child(2) { opacity: 0; }
  .mobile-nav[open] .hamburger-bar:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }

  /* The panel hangs from the bottom edge of the sticky header (the nearest positioned ancestor), full
     width, and scrolls on its own when a short landscape screen cannot fit every link. */
  .mobile-drawer {
    position: absolute;
    inset-inline: 0;
    top: 100%;
    max-height: calc(100dvh - 4.5rem);
    overflow-y: auto;
    overscroll-behavior: contain;
  }
  .mobile-nav[open] > .mobile-drawer { animation: drawer-in 0.2s ease-out; }
  @keyframes drawer-in { from { opacity: 0; transform: translateY(-6px); } }
</style>

<script>
  // Enhancement only: the menu already opens and closes without this (it is a <details>).
  const nav = document.getElementById('mobile-nav') as HTMLDetailsElement | null;
  const toggle = document.getElementById('menu-toggle');
  if (nav && toggle) {
    const close = () => {
      nav.open = false;
    };
    // Same-page links (/#pricing) keep the menu open otherwise.
    nav.addEventListener('click', (e) => {
      if ((e.target as Element).closest('#mobile-menu a[href]')) close();
    });
    // Tap outside the open menu.
    document.addEventListener('click', (e) => {
      if (nav.open && !nav.contains(e.target as Node)) close();
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && nav.open) {
        close();
        toggle.focus();
      }
    });
    // Coming back through the browser's back button must not show the menu open.
    window.addEventListener('pageshow', close);
    window.matchMedia('(min-width: 1024px)').addEventListener('change', (e) => {
      if (e.matches) close();
    });
  }
</script>
