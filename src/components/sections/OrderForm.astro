---
import { siteData } from '../../data/siteData';
import { ACCEPTED_PHOTO_TYPES, AU_STATES, DEFAULT_ORDER_API_URL, MAX_PADDLES } from '../../lib/order';
import { BRAND_LIST_REVIEWED } from '../../lib/suggest';

const price = siteData.pricing.regritPerPaddle;
// SCRUM-68: relative, so one image serves staging, the tailnet and production. An explicitly empty
// PUBLIC_ORDER_API_URL turns online ordering off at build time (the email notice shows instead).
const endpoint = import.meta.env.PUBLIC_ORDER_API_URL ?? DEFAULT_ORDER_API_URL;
const accept = ACCEPTED_PHOTO_TYPES.join(',');
// SCRUM-40: the drafted brand list needs Attila's check before release (pnpm check:placeholders).
const brandListReview = BRAND_LIST_REVIEWED ? undefined : '[To confirm: Attila checks the brand and model list in src/data/paddle-brands.json (SCRUM-40)]';
const field = 'mt-1 block w-full rounded-md border border-border bg-surface px-3 py-2.5 text-base text-text';
const label = 'block text-sm font-semibold';
const err = 'mt-1 text-sm font-medium text-[#A12B2B]';
---

<section id="order" class="bg-tint-blue py-section">
  <div class="mx-auto max-w-3xl px-4 sm:px-6">
    <p class="topper">Order</p>
    <h2 class="mt-2 font-heading text-h2 font-bold">Send in your paddle</h2>
    <p class="mt-3 leading-relaxed text-text-muted">
      Tell us about each paddle and add a photo of its front and back. We'll check the photos and email you
      within {siteData.pricing.replyTime} to confirm and send a payment link.
      You don't pay anything now.
    </p>

    <p id="ordering-closed" class="mt-6 rounded-md border border-primary bg-surface p-4 text-sm" data-testid="ordering-closed" hidden={!!endpoint}>
      Online ordering opens soon. In the meantime, email
      <a class="font-semibold text-primary underline" href={`mailto:${siteData.contact.email}`}>{siteData.contact.email}</a>.
    </p>

    <p class="test-order-notice" data-env="staging-only" data-testid="test-order-notice" role="note" hidden>
      <strong>Preview site:</strong> anything you submit here is a test order. No payment is taken.
    </p>

    <div id="order-done" class="mt-8 rounded-lg bg-surface p-6 sm:p-8" data-testid="order-done" role="status" hidden>
      <h3 id="done-heading" class="font-heading text-h3 font-bold" tabindex="-1">Thanks, we’ve got your order</h3>
      <p class="mt-3 leading-relaxed">
        Your reference is <strong id="done-reference" class="font-heading" data-testid="done-reference"></strong>.
        We’ll check your photos and email you within {siteData.pricing.replyTime}.
      </p>
      <p id="done-test" class="mt-3 rounded-md bg-tint-blue p-3 text-sm" data-testid="done-test" hidden>
        <strong>This was a TEST order</strong> on the preview site: no paddle needs to be sent and no payment is taken.
      </p>
      <p class="mt-4 leading-relaxed">
        Follow your order at your private status link. Bookmark it, and please don’t share it: anyone with the link can see the status.
      </p>
      <p class="mt-2 break-all text-sm"><a id="done-status-link" class="font-semibold text-primary underline" data-testid="done-status-link" href="/order/status"></a></p>
      <button type="button" id="order-another" class="btn-secondary mt-6">Send another order</button>
    </div>

    <form
      id="order-form"
      class="mt-8 space-y-8 rounded-lg bg-surface p-6 sm:p-8"
      method="post"
      enctype="multipart/form-data"
      action={endpoint || undefined}
      data-endpoint={endpoint}
      data-contact={siteData.contact.email}
      data-price={price}
      data-max={MAX_PADDLES}
      data-review={brandListReview}
      novalidate
    >
      <div id="form-status" role="status" aria-live="polite" class="hidden rounded-md p-4 text-sm"></div>

      <!-- Set by the script: the signed load time (SCRUM-67) and one key per submission (SCRUM-65). -->
      <input type="hidden" name="formToken" value="" />
      <input type="hidden" name="idempotencyKey" value="" />
      <!-- SCRUM-67 honeypot: people never see or reach this field; bots fill it in. -->
      <div class="absolute -left-[10000px] top-auto h-px w-px overflow-hidden" aria-hidden="true" data-testid="honeypot">
        <label for="website">Your website</label>
        <input id="website" name="website" type="text" tabindex="-1" autocomplete="off" value="" />
      </div>

      <fieldset class="space-y-4">
        <legend class="font-heading text-h3 font-bold">Your details</legend>
        <div>
          <label for="name" class={label}>Full name</label>
          <input id="name" name="name" autocomplete="name" required class={field} aria-describedby="name-error" />
          <p id="name-error" class={err} hidden></p>
        </div>
        <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
          <div>
            <label for="email" class={label}>Email</label>
            <input id="email" name="email" type="email" autocomplete="email" required class={field} aria-describedby="email-error" />
            <p id="email-error" class={err} hidden></p>
          </div>
          <div>
            <label for="phone" class={label}>Phone <span class="font-normal text-text-muted">(optional)</span></label>
            <input id="phone" name="phone" type="tel" autocomplete="tel" class={field} aria-describedby="phone-error" />
            <p id="phone-error" class={err} hidden></p>
          </div>
        </div>
      </fieldset>

      <fieldset class="space-y-4">
        <legend class="font-heading text-h3 font-bold">Return address</legend>
        <div>
          <label for="street" class={label}>Street address</label>
          <input id="street" name="street" autocomplete="street-address" required class={field} aria-describedby="street-error" />
          <p id="street-error" class={err} hidden></p>
        </div>
        <div class="grid grid-cols-1 gap-4 sm:grid-cols-3">
          <div>
            <label for="suburb" class={label}>Suburb</label>
            <input id="suburb" name="suburb" autocomplete="address-level2" required class={field} aria-describedby="suburb-error" />
            <p id="suburb-error" class={err} hidden></p>
          </div>
          <div>
            <label for="state" class={label}>State</label>
            <select id="state" name="state" autocomplete="address-level1" required class={field} aria-describedby="state-error">
              <option value="">Choose…</option>
              {AU_STATES.map((s) => <option value={s}>{s}</option>)}
            </select>
            <p id="state-error" class={err} hidden></p>
          </div>
          <div>
            <label for="postcode" class={label}>Postcode</label>
            <input id="postcode" name="postcode" inputmode="numeric" autocomplete="postal-code" maxlength="4" required class={field} aria-describedby="postcode-error" />
            <p id="postcode-error" class={err} hidden></p>
          </div>
        </div>
      </fieldset>

      <div class="space-y-4">
        <h3 class="font-heading text-h3 font-bold">Your paddles</h3>
        <p id="paddles-error" class={err} hidden></p>
        <div id="paddle-list" class="space-y-4"></div>
        <button type="button" id="add-paddle" class="btn-secondary">+ Add another paddle</button>
        <p class="text-sm text-text-muted">
          Estimate: <strong id="estimate">A${price}</strong> for re-gritting, plus return postage<span id="postage-estimate"></span>.
        </p>
      </div>

      <div>
        <div class="flex items-start gap-3">
          <input id="consent" name="consent" type="checkbox" value="yes" required class="mt-1 size-5 shrink-0 accent-primary" aria-describedby="consent-error" />
          <label for="consent" class="text-sm leading-relaxed">
            I agree to PickleMyPaddle storing my details and paddle photos to process this order, as described in the
            <a href="/privacy" class="font-semibold text-primary underline">privacy policy</a>.
          </label>
        </div>
        <p id="consent-error" class={err} hidden></p>

        <div class="mt-4 flex items-start gap-3">
          <input id="tournamentAck" name="tournamentAck" type="checkbox" value="yes" required class="mt-1 size-5 shrink-0 accent-primary" aria-describedby="tournamentAck-error" />
          <label for="tournamentAck" class="text-sm leading-relaxed">
            I understand that once my paddle is re-gritted, it can no longer be used in sanctioned competitions or
            tournaments.
          </label>
        </div>
        <p id="tournamentAck-error" class={err} hidden></p>
      </div>

      <div class="flex flex-col gap-2 sm:flex-row sm:items-center sm:gap-4">
        <button type="submit" id="order-submit" class="btn-primary w-full disabled:cursor-not-allowed disabled:opacity-50 sm:w-auto" aria-describedby="submit-hint">Submit for review</button>
        <p id="submit-hint" class="text-sm text-text-muted" hidden>Tick both boxes above to submit.</p>
      </div>
    </form>

    <template id="paddle-template">
      <fieldset class="paddle rounded-md border border-border p-4" data-index="__i__">
        <legend class="px-1 font-semibold">Paddle <span class="paddle-number">__n__</span></legend>
        <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
          <div class="relative">
            <label for="paddles-__i__-brand" class={label}>Brand</label>
            <input id="paddles-__i__-brand" name="paddles[__i__][brand]" required maxlength="60" class={field} aria-describedby="paddles-__i__-brand-error" />
            <p id="paddles-__i__-brand-error" class={err} hidden></p>
          </div>
          <div class="relative">
            <label for="paddles-__i__-model" class={label}>Model <span class="font-normal text-text-muted">(optional)</span></label>
            <input id="paddles-__i__-model" name="paddles[__i__][model]" maxlength="80" class={field} aria-describedby="paddles-__i__-model-error" />
            <p id="paddles-__i__-model-error" class={err} hidden></p>
          </div>
          <div>
            <label for="paddles-__i__-front" class={label}>Photo of the front</label>
            <input id="paddles-__i__-front" name="paddles[__i__][front]" type="file" accept={accept} required class={field} aria-describedby="paddles-__i__-front-error" />
            <p id="paddles-__i__-front-error" class={err} hidden></p>
          </div>
          <div>
            <label for="paddles-__i__-back" class={label}>Photo of the back</label>
            <input id="paddles-__i__-back" name="paddles[__i__][back]" type="file" accept={accept} required class={field} aria-describedby="paddles-__i__-back-error" />
            <p id="paddles-__i__-back-error" class={err} hidden></p>
          </div>
        </div>
        <button type="button" class="remove-paddle mt-3 text-sm font-semibold text-primary underline">Remove this paddle</button>
      </fieldset>
    </template>
  </div>
</section>

<script>
  // Bundled into an external file by Astro, so the CSP keeps script-src 'self'.
  import '../../scripts/order-form';
</script>
