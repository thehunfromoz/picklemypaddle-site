---
/**
 * Testimonials (SCRUM-33): real reviews, published with permission as first name and suburb.
 * Hidden until there are at least 3 (src/lib/visibility.ts). `items` is for tests.
 */
import { loadTestimonials, type Testimonial } from '../../lib/testimonials';
import { showTestimonials } from '../../lib/visibility';

interface Props {
  items?: Testimonial[];
}
const testimonials = Astro.props.items ?? loadTestimonials();
---

{showTestimonials(testimonials) && (
  <section id="testimonials" class="py-section">
    <div class="mx-auto max-w-site px-4 sm:px-6">
      <div class="max-w-2xl">
        <p class="topper">Players and clubs</p>
        <h2 class="mt-2 font-heading text-h2 font-bold">What customers say</h2>
      </div>
      <ul class="mt-10 grid grid-cols-1 gap-6 md:grid-cols-2" role="list">
        {testimonials.map((t) => (
          <li>
            <figure class="h-full rounded-lg border border-border bg-surface p-6">
              <blockquote class="text-lg leading-relaxed">&ldquo;{t.quote}&rdquo;</blockquote>
              <figcaption class="mt-4 text-sm">
                <span class="font-semibold">{t.firstName}</span>,{' '}
                <span class="text-text-muted">{t.suburb}</span>
              </figcaption>
            </figure>
          </li>
        ))}
      </ul>
    </div>
  </section>
)}
