---
interface Props {
  title: string;
  intro?: string;
}
const { title, intro } = Astro.props;
---

<section class="bg-tint-blue py-12 sm:py-14 lg:py-16">
  <div class="mx-auto max-w-site px-4 sm:px-6">
    <h1 class="font-heading text-h1 font-bold text-text">{title}</h1>
    {intro && <p class="mt-3 max-w-2xl text-lead leading-relaxed text-text-muted">{intro}</p>}
  </div>
</section>
