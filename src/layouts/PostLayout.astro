---
import type { ImageMetadata } from 'astro';
import { Image, getImage } from 'astro:assets';
import BaseLayout from './BaseLayout.astro';
import { siteData } from '../data/siteData';

interface Props {
  title: string;
  seoTitle?: string;
  description: string;
  date: Date;
  author?: string;
  /** Optional cover image; the content schema requires coverAlt whenever it is set (SCRUM-34). */
  cover?: ImageMetadata;
  coverAlt?: string;
  lang?: string;
  /** The blog index in the post's language, for the breadcrumb. */
  indexHref?: string;
  alternates?: { hreflang: string; href: string }[];
}

const { title, seoTitle, description, date, author = 'PickleMyPaddle', cover, coverAlt, lang = 'en-AU', indexHref = '/blog', alternates = [] } =
  Astro.props;
const formattedDate = date.toLocaleDateString(lang, { year: 'numeric', month: 'long', day: 'numeric' });
// The cover doubles as the share image (1200 wide is what social cards use).
const shareImage = cover ? (await getImage({ src: cover, width: 1200, format: 'jpg' })).src : undefined;
---

<BaseLayout
  title={seoTitle ?? title}
  description={description}
  lang={lang}
  alternates={alternates}
  image={shareImage}
  imageAlt={cover ? coverAlt : undefined}
>
  <section class="bg-tint-blue py-12 sm:py-14 lg:py-16">
    <div class="mx-auto max-w-3xl px-4 sm:px-6">
      <nav aria-label="Breadcrumb" class="mb-4 text-sm">
        <a href={indexHref} class="font-medium text-primary hover:text-primary-dark">&larr; Blog</a>
      </nav>
      <h1 class="font-heading text-h1 font-bold text-text">{title}</h1>
      <p class="mt-3 text-sm text-text-muted">
        {author} &middot; <time datetime={date.toISOString()}>{formattedDate}</time>
      </p>
    </div>
  </section>

  <section class="py-section">
    <div class="mx-auto max-w-3xl px-4 sm:px-6">
      {
        cover && (
          <Image
            src={cover}
            alt={coverAlt ?? ''}
            widths={[400, 800, 1200]}
            sizes="(min-width: 768px) 768px, 100vw"
            class="mb-10 w-full rounded-lg"
            data-testid="post-cover"
          />
        )
      }
      <article class="prose prose-lg max-w-none prose-headings:font-heading prose-a:text-primary">
        <slot />
      </article>
      <div class="mt-12 rounded-lg bg-tint-green p-6 sm:p-8">
        <p class="font-heading text-h3 font-bold">Is your paddle losing its grip?</p>
        <p class="mt-2 text-text-muted">We re-grit pickleball paddles for A${siteData.pricing.regritPerPaddle} each.</p>
        <a href={siteData.orderCta.href} class="btn-primary mt-4">{siteData.orderCta.label}</a>
      </div>
    </div>
  </section>
</BaseLayout>
