---
/**
 * Base layout — wraps every page.
 * No inline scripts or styles: everything is bundled so the
 * Content-Security-Policy can stay at 'self' (see deploy/Caddyfile).
 */
import '../styles/global.css';
import { brand } from '../config/brand';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import MobileOrderBar from '../components/MobileOrderBar.astro';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  schema?: Record<string, unknown>;
}

const {
  title = brand.name,
  description = brand.description,
  image = '/og-image.png',
  schema,
} = Astro.props;

const pageTitle = title === brand.name ? `${brand.name} · Pickleball paddle re-gritting` : `${title} · ${brand.name}`;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const imageURL = new URL(image, Astro.site);
---

<html lang="en-AU">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#4565A6" />

    <link rel="canonical" href={canonicalURL} />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={brand.name} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={imageURL} />
    <meta property="og:locale" content={brand.locale} />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    {schema && <script type="application/ld+json" set:html={JSON.stringify(schema)} />}

    <slot name="head" />
  </head>

  <body class="bg-background pb-20 font-body text-text antialiased lg:pb-0">
    <a
      class="sr-only focus:not-sr-only focus:absolute focus:z-[99999] focus:rounded-md focus:bg-primary focus:px-4 focus:py-2 focus:text-primary-fg"
      href="#main"
    >
      Skip to main content
    </a>

    <Header />

    <main id="main">
      <slot />
    </main>

    <Footer />
    <MobileOrderBar />
  </body>
</html>
