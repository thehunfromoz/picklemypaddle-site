---
/**
 * Base layout — wraps every page.
 * No inline scripts or styles: everything is bundled so the
 * Content-Security-Policy can stay at 'self' (see deploy/Caddyfile).
 */
import '../styles/global.css';
import { brand } from '../config/brand';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import MobileOrderBar from '../components/MobileOrderBar.astro';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  /** Alt text for the share image; defaults to the words on the default og-image.png. */
  imageAlt?: string;
  /** One JSON-LD object, or several; each is written as its own script. */
  schema?: object | object[];
  /** Keep the page out of search results (the 404 page). */
  noindex?: boolean;
  /** The page's language (BCP 47), for <html lang>. */
  lang?: string;
  /** hreflang links to this page in other languages (SCRUM-34); empty for single-language pages. */
  alternates?: { hreflang: string; href: string }[];
}

const {
  title = brand.name,
  description = brand.description,
  image = '/og-image.png',
  imageAlt = `${brand.name}. Pickleball paddle re-gritting. ${brand.tagline}`,
  schema,
  noindex = false,
  lang = 'en-AU',
  alternates = [],
} = Astro.props;

const pageTitle = title === brand.name ? `${brand.name} · Pickleball paddle re-gritting` : `${title} · ${brand.name}`;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const imageURL = new URL(image, Astro.site);
// The default share image is 1200x630 (scripts/make-og-image.mjs); a custom image says its own size or none.
const imageSize = image === '/og-image.png' ? { width: '1200', height: '630', type: 'image/png' } : undefined;
const schemas = schema === undefined ? [] : Array.isArray(schema) ? schema : [schema];
---

<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#4565A6" />

    <link rel="canonical" href={canonicalURL} />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    {/* Same trailing-slash form as the canonical link and the sitemap. */}
    {alternates.map((alt) => <link rel="alternate" hreflang={alt.hreflang} href={new URL(alt.href.replace(/\/?$/, '/'), Astro.site)} />)}
    <link rel="alternate" type="application/rss+xml" title={`${brand.name} blog`} href="/rss.xml" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={brand.name} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={imageURL} />
    {imageSize && <meta property="og:image:width" content={imageSize.width} />}
    {imageSize && <meta property="og:image:height" content={imageSize.height} />}
    {imageSize && <meta property="og:image:type" content={imageSize.type} />}
    <meta property="og:image:alt" content={imageAlt} />
    <meta property="og:locale" content={brand.locale} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageURL} />
    <meta name="twitter:image:alt" content={imageAlt} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <!-- Empty on the live site; the staging gateway serves one that shows the Preview ribbon (SCRUM-38). -->
    <link rel="stylesheet" href="/env.css" />

    {schemas.map((item) => <script type="application/ld+json" set:html={JSON.stringify(item)} />)}

    <slot name="head" />
  </head>

  <body class="bg-background pb-[calc(6rem+env(safe-area-inset-bottom))] font-body text-text antialiased lg:pb-0">
    <div class="preview-ribbon" data-env="staging-only" data-testid="preview-ribbon" role="note" hidden>
      <strong>Preview</strong> · not the live site. Orders here are tests; no payment is taken.
    </div>

    <a
      class="sr-only focus:not-sr-only focus:absolute focus:z-[99999] focus:rounded-md focus:bg-primary focus:px-4 focus:py-2 focus:text-primary-fg"
      href="#main"
    >
      Skip to main content
    </a>

    <Header />

    <main id="main">
      <slot />
    </main>

    <Footer />
    <MobileOrderBar />
  </body>
</html>
